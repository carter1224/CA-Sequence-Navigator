<Window x:Class="SequenceNavigator.FindWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find in sequences" Width="820" Height="560" MinWidth="560" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <!-- Modeless, so the engineer can jump to a result, look at the cards, and come back to
       the same list. -->
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center"
                 Margin="0,0,10,0" Foreground="{StaticResource SubtleTextBrush}"/>
      <TextBox x:Name="SearchBox" Grid.Column="1" FontSize="14" TextChanged="SearchBox_TextChanged"
               PreviewKeyDown="SearchBox_PreviewKeyDown" AutomationProperties.Name="Search"/>
    </Grid>
    <TextBlock x:Name="ResultText" Grid.Row="1" Style="{StaticResource HintText}" Margin="26,6,0,10"
               Text="Type part of a description or tag name, e.g. Material Transfer Run or MTFR_R. Lists every step where it is on."/>

    <ListView x:Name="Results" Grid.Row="2" MouseDoubleClick="Results_MouseDoubleClick"
              KeyDown="Results_KeyDown" SelectionMode="Single" AutomationProperties.Name="Results">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Sequence" Width="200" DisplayMemberBinding="{Binding Sequence}"/>
          <GridViewColumn Header="Step" Width="60" DisplayMemberBinding="{Binding StepText}"/>
          <GridViewColumn Header="Tab" Width="85" DisplayMemberBinding="{Binding Tab}"/>
          <GridViewColumn Header="Field" Width="320" DisplayMemberBinding="{Binding Field}"/>
          <GridViewColumn Header="Value" Width="90" DisplayMemberBinding="{Binding Value}"/>
        </GridView>
      </ListView.View>
    </ListView>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Go to step" Style="{StaticResource PrimaryButton}" Click="GoTo_Click"/>
      <Button Content="Close" Margin="8,0,0,0" IsCancel="True" Click="Close_Click"/>
    </StackPanel>
  </Grid>
</Window>
