<Window x:Class="SequenceNavigator.CompareSequencesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compare backups" Width="720" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AllowDrop="True"
        DragOver="Window_DragOver" Drop="Window_Drop">
  <StackPanel Margin="20">
    <TextBlock Text="Compare backups" FontSize="16" FontWeight="SemiBold"/>
    <!-- Order matters and the boxes used to be unlabelled, so say so up front. -->
    <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,16"
               Text="Differences are listed as A to B, so pick the order that reads the way you want. You can drop backup ZIPs onto the boxes."/>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Text="Backup A" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBox x:Name="FirstZipBox" Grid.Column="1" Margin="12,0,8,0" IsReadOnly="True"
               AllowDrop="True" PreviewDragOver="Box_PreviewDragOver" PreviewDrop="FirstBox_PreviewDrop"
               AutomationProperties.Name="Backup A"/>
      <Button Grid.Column="2" Content="Browse…" Click="BrowseFirst_Click"/>

      <Button x:Name="SwapBtn" Grid.Row="1" Grid.Column="1" Style="{StaticResource QuietButton}"
              HorizontalAlignment="Left" Margin="8,4,0,4" Click="Swap_Click" ToolTip="Swap A and B">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource IconText}" Text="&#xE8AB;" Foreground="{StaticResource PrimaryBrush}"/>
          <TextBlock Text="Swap A and B" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>

      <TextBlock Grid.Row="2" Text="Backup B" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBox x:Name="SecondZipBox" Grid.Row="2" Grid.Column="1" Margin="12,0,8,0" IsReadOnly="True"
               AllowDrop="True" PreviewDragOver="Box_PreviewDragOver" PreviewDrop="SecondBox_PreviewDrop"
               AutomationProperties.Name="Backup B"/>
      <Button Grid.Row="2" Grid.Column="2" Content="Browse…" Click="BrowseSecond_Click"/>
    </Grid>

    <!-- The drift check: has anyone changed the controller since this backup? -->
    <Border x:Name="PlcOption" Margin="0,18,0,0" Padding="12,10" CornerRadius="6"
            Background="{StaticResource AppBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Has the PLC changed since this backup?" FontWeight="SemiBold"/>
          <TextBlock x:Name="PlcOptionText" Style="{StaticResource HintText}" Margin="0,2,0,0"
                     Text="Reads the controller now (nothing is changed on it) and compares it with the open backup."/>
        </StackPanel>
        <Button x:Name="ComparePlcBtn" Grid.Column="1" Margin="12,0,0,0" Click="ComparePlc_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource IconText}" Text="&#xE898;"/>
            <TextBlock Style="{StaticResource ButtonLabel}" Text="Compare with PLC…"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="CompareBtn" Content="Compare" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Compare_Click"/>
      <Button Content="Cancel" Margin="8,0,0,0" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
