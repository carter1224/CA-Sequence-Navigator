<Window x:Class="SequenceNavigator.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="20">
    <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

    <!-- Display changes apply as soon as they are ticked, so the effect is visible; Cancel
         puts them back. -->
    <TextBlock Text="DISPLAY" Style="{StaticResource SectionHeader}"/>
    <CheckBox x:Name="ShowDescriptionsBox" Content="Show field descriptions on the cards"
              Checked="Display_Changed" Unchecked="Display_Changed"/>
    <CheckBox x:Name="HighlightBox" Content="Highlight active values in green" Margin="0,6,0,0"
              Checked="Display_Changed" Unchecked="Display_Changed"/>

    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16"/>

    <TextBlock Text="CONNECTION RELIABILITY" Style="{StaticResource SectionHeader}"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="170"/>
        <ColumnDefinition Width="90"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="Retries after a failure" VerticalAlignment="Center"/>
      <TextBox x:Name="RetryBox" Grid.Column="1" AutomationProperties.Name="Retries after a failure"/>
      <TextBlock Grid.Column="2" Text="attempts (0 to 20)" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="10,0,0,0"/>

      <TextBlock Grid.Row="1" Text="Wait between retries" VerticalAlignment="Center" Margin="0,8,0,0"/>
      <TextBox x:Name="DelayBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" AutomationProperties.Name="Wait between retries"/>
      <TextBlock Grid.Row="1" Grid.Column="2" Text="seconds (0 to 60)" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="10,8,0,0"/>

      <TextBlock Grid.Row="2" Text="Give up waiting after" VerticalAlignment="Center" Margin="0,8,0,0"/>
      <TextBox x:Name="TimeoutBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" AutomationProperties.Name="Connection timeout"/>
      <TextBlock Grid.Row="2" Grid.Column="2" Text="seconds (1 to 120)" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="10,8,0,0"/>
    </Grid>
    <TextBlock x:Name="ReliabilityError" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>
    <CheckBox x:Name="ProgramTagsBox" Content="Include sequences stored inside programs" Margin="0,12,0,0"/>
    <TextBlock Style="{StaticResource HintText}" Margin="22,2,0,0"
               Text="By default only controller-wide SEQ[100] tags are backed up. Tick this if some sequences live in a program's own tags."/>

    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16"/>

    <TextBlock Text="DIAGNOSTICS" Style="{StaticResource SectionHeader}"/>
    <CheckBox x:Name="DebugLogBox" Content="Keep a debug log of PLC transfers"/>
    <Grid Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox x:Name="LogPathBox" AutomationProperties.Name="Log file"/>
      <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click"/>
      <Button Grid.Column="2" Content="Open log folder" Margin="8,0,0,0" Click="OpenLogFolder_Click"/>
    </Grid>
    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
               Text="A file name on its own is kept in your Sequence Navigator data folder."/>

    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16"/>

    <TextBlock Text="ABOUT" Style="{StaticResource SectionHeader}"/>
    <StackPanel Orientation="Horizontal">
      <TextBlock x:Name="VersionText" VerticalAlignment="Center"/>
      <Button Style="{StaticResource QuietButton}" Margin="12,0,0,0" Click="ReleaseNotes_Click"
              Foreground="{StaticResource PrimaryBrush}" Content="Release notes"/>
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
      <Button Content="Cancel" Margin="8,0,0,0" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
