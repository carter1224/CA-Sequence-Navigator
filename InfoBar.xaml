<UserControl x:Class="SequenceNavigator.InfoBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
  <!-- An inline, non-blocking message: results, errors and warnings that should be
       noticed but must not stop the engineer with a pop-up. Stays until closed. -->
  <Border x:Name="Root" CornerRadius="6" BorderThickness="1" Padding="12,8" Margin="0,0,0,10">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="Icon" Grid.Column="0" FontFamily="{StaticResource IconFont}" FontSize="16"
                 Margin="0,2,12,0" VerticalAlignment="Top"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock TextWrapping="Wrap">
          <Run x:Name="TitleRun" FontWeight="SemiBold"/>
          <Run x:Name="MessageRun"/>
        </TextBlock>
        <Button x:Name="DetailsButton" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"
                Margin="-8,2,0,0" MinHeight="0" Padding="8,2" Content="Show details"
                Click="DetailsButton_Click" Visibility="Collapsed"/>
        <TextBox x:Name="DetailsBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                 Margin="0,4,0,0" Visibility="Collapsed"/>
      </StackPanel>
      <Button x:Name="ActionButton" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
              Click="ActionButton_Click" Visibility="Collapsed"/>
      <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource QuietButton}" Margin="8,0,0,0"
              VerticalAlignment="Top" ToolTip="Close" AutomationProperties.Name="Close message"
              Click="CloseButton_Click">
        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
      </Button>
    </Grid>
  </Border>
</UserControl>
