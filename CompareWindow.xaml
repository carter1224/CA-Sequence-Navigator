<Window x:Class="SequenceNavigator.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compare backups" Width="1060" Height="640" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <!-- Its own window, so the main window and its HMI-matched cards stay untouched while
       the engineer reads the differences. -->
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="A" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
          <TextBlock x:Name="LabelA" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
          <Button x:Name="SwapBtn" Style="{StaticResource QuietButton}" Margin="16,0" Click="Swap_Click"
                  ToolTip="Swap A and B" AutomationProperties.Name="Swap A and B">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource IconText}" Text="&#xE8AB;" Foreground="{StaticResource PrimaryBrush}"/>
              <TextBlock Text="Swap" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <TextBlock Text="B" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
          <TextBlock x:Name="LabelB" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="SummaryText" Style="{StaticResource HintText}" Margin="0,6,0,0"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="SEQUENCES THAT DIFFER" Style="{StaticResource SectionHeader}" Margin="12,10,12,4"/>
          <TextBlock x:Name="IdenticalText" DockPanel.Dock="Bottom" Style="{StaticResource HintText}" Margin="12,6,12,10"/>
          <ListBox x:Name="SequenceList" BorderThickness="0" SelectionChanged="SequenceList_SelectionChanged"
                   AutomationProperties.Name="Sequences that differ">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Width="210">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Sequence}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="1" Text="{Binding CountText}" FontWeight="SemiBold" Margin="8,0,0,0"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
        <Grid>
          <ListView x:Name="DifferenceList" BorderThickness="0" MouseDoubleClick="DifferenceList_MouseDoubleClick"
                    SelectionChanged="DifferenceList_SelectionChanged"
                    SelectionMode="Single" AutomationProperties.Name="Differences">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Sequence" Width="190" DisplayMemberBinding="{Binding Sequence}"/>
                <GridViewColumn Header="Step" Width="70" DisplayMemberBinding="{Binding StepText}"/>
                <GridViewColumn Header="Tab" Width="85" DisplayMemberBinding="{Binding Tab}"/>
                <GridViewColumn Header="Field" Width="250" DisplayMemberBinding="{Binding Field}"/>
                <GridViewColumn Header="A" Width="80" DisplayMemberBinding="{Binding A}"/>
                <GridViewColumn Header="B" Width="80">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding B}" FontWeight="SemiBold"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
          <StackPanel x:Name="NoDifferences" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="&#xE930;" FontFamily="{StaticResource IconFont}" FontSize="32" Foreground="#2D7D46" HorizontalAlignment="Center"/>
            <TextBlock Text="No differences" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock x:Name="NoDifferencesDetail" Style="{StaticResource HintText}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="ShowBtn" Style="{StaticResource PrimaryButton}" Click="Show_Click"
                ToolTip="Open A at this sequence, step and tab in the main window">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource IconText}" Text="&#xE8A7;"/>
            <TextBlock Style="{StaticResource ButtonLabel}" Text="Show in main window"/>
          </StackPanel>
        </Button>
        <TextBlock x:Name="ShowHint" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Content="Export report…" Click="ExportText_Click"/>
        <Button Content="Export CSV…" Margin="8,0,0,0" Click="ExportCsv_Click"/>
        <Button Content="Close" Margin="8,0,0,0" IsCancel="True" Click="Close_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
