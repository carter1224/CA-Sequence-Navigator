<Window x:Class="SequenceNavigator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Sequence Navigator" Height="820" Width="1180" Icon="CA.ico"
        MinWidth="1040" MinHeight="600">
  <Window.Resources>
    <Style x:Key="DescTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#222"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding DataContext.ShowDescriptions, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
            <Condition Binding="{Binding HasDescription}" Value="True"/>
          </MultiDataTrigger.Conditions>
          <Setter Property="Visibility" Value="Visible"/>
        </MultiDataTrigger>
      </Style.Triggers>
    </Style>
    <!-- Card text uses exactly two sizes: 12 for the description and the value, 11 for
         the tag name. Every one is set explicitly, because anything left unset inherits
         13 from the Window style and produced a third size inside the same card. -->
    <Style x:Key="TagTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Foreground" Value="#666"/>
    </Style>

    <!-- Shared by every SEQ group tab. Declared after the styles above because
         StaticResource resolves in parse order. -->
    <ItemsPanelTemplate x:Key="FieldItemsPanel">
      <UniformGrid Columns="4"/>
    </ItemsPanelTemplate>

    <DataTemplate x:Key="FieldItemTemplate">
      <Border Style="{StaticResource CardBorderStyle}">
        <Border.Background>
          <MultiBinding Converter="{StaticResource ValueHighlightConverter}">
            <Binding Path="Value"/>
            <Binding Path="DataContext.HighlightActive" RelativeSource="{RelativeSource AncestorType=Window}"/>
          </MultiBinding>
        </Border.Background>
        <StackPanel>
          <TextBlock Text="{Binding Description}" Style="{StaticResource DescTextStyle}"/>
          <TextBlock Text="{Binding Name}" Style="{StaticResource TagTextStyle}"/>

          <!-- Boolean fields: dropdown. The array stays inline so each card gets its
               own instance rather than every ComboBox sharing one collection view. -->
          <ComboBox SelectedItem="{Binding Value, Mode=TwoWay}" FontSize="12"
                    IsEnabled="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}">
            <ComboBox.Style>
              <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsBoolean}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ComboBox.Style>
            <ComboBox.ItemsSource>
              <x:Array Type="sys:String">
                <sys:String>true</sys:String>
                <sys:String>false</sys:String>
              </x:Array>
            </ComboBox.ItemsSource>
          </ComboBox>

          <!-- Numeric fields: editable text box. -->
          <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" FontSize="12"
                   IsEnabled="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}"
                   MinWidth="140"
                   HorizontalAlignment="Stretch">
            <TextBox.Style>
              <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsNumber}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBox.Style>
          </TextBox>

          <!-- Anything else: read-only. -->
          <TextBlock Text="{Binding Value}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding IsBoolean}" Value="False"/>
                      <Condition Binding="{Binding IsNumber}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- One header panel rather than two stacked boxes plus a floating text line:
         file actions on top, sequence navigation and edit/transfer below a thin
         divider, with the tag metadata inside the same border. -->
    <Border Grid.Row="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" Padding="12" CornerRadius="6" Margin="0,0,0,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- File: open/upload on the left, the loaded file in the middle, tools right. -->
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="OpenZipBtn" Grid.Column="0" Content="Open ZIP" Click="OpenZip_Click"/>
          <Button x:Name="ImportBtn" Grid.Column="1" Content="Upload from PLC" Margin="8,0,0,0" Click="ImportFromPlc_Click"/>
          <!-- Filename only; the full path is the tooltip. A full-width read-only text
               box used to dominate this row for no benefit. -->
          <TextBlock x:Name="PathBox" Grid.Column="2" Margin="16,0,16,0" VerticalAlignment="Center"
                     FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <Button x:Name="CompareBtn" Grid.Column="3" Content="Compare Sequences" Click="CompareSequences_Click"/>
          <Button x:Name="AdvancedBtn" Grid.Column="4" Content="Advanced Settings" Margin="8,0,0,0" Click="AdvancedSettings_Click"/>
        </Grid>

        <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,12"/>

        <!-- Navigation only. Edit Mode / Save Changes / Download to PLC live on the tab
             strip band below, beside the group tabs. -->
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="JsonPicker" Grid.Column="0" Width="220" SelectionChanged="JsonPicker_SelectionChanged"/>
          <!-- The step readout leads the navigation group, then a gap before the controls
               that change it. MinWidth keeps "Step 9" and "Step 99" the same width so the
               buttons beside it never shift. -->
          <TextBlock x:Name="IndexLabel" Grid.Column="1" FontWeight="Bold" FontSize="15"
                     Margin="24,0,0,0" VerticalAlignment="Center" MinWidth="70" TextAlignment="Center"/>
          <Button x:Name="PrevBtn" Grid.Column="2" Content="&lt; Prev" Margin="16,0,0,0" Click="Prev_Click"/>
          <!-- Type a step and press Enter. MaxLength 2 plus digits-only input means an
               out-of-range entry is very nearly impossible to type in the first place.

               Locked to a 30x30 square: Width/Height fix the size, and the local Min/Max
               pair stops the shared TextBox style's MinHeight (or any later change to it)
               from stretching it back out. 30 matches the button height beside it. Padding
               is zeroed because the style's 8,4 would leave too little room for two digits
               at this size, with content centred both ways instead. -->
          <TextBox x:Name="IndexBox" Grid.Column="3" VerticalAlignment="Center" Margin="8,0,0,0"
                   Width="30" Height="30"
                   MinWidth="30" MinHeight="30" MaxWidth="30" MaxHeight="30"
                   Padding="0" TextAlignment="Center" VerticalContentAlignment="Center"
                   MaxLength="2" ToolTip="Type a step number and press Enter"
                   KeyDown="IndexBox_KeyDown" PreviewTextInput="IndexBox_PreviewTextInput"/>
          <Button x:Name="NextBtn" Grid.Column="4" Content="Next >" Margin="8,0,0,0" Click="Next_Click"/>

          <TextBlock Grid.Column="5" Text="EDIT MODE" Foreground="#B00000" FontWeight="Bold" FontSize="16"
                     Margin="24,0,24,0" VerticalAlignment="Center" HorizontalAlignment="Left">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=EditToggle}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                  <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="EditModeBlink">
                      <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.6"/>
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.EnterActions>
                  <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="EditModeBlink"/>
                  </DataTrigger.ExitActions>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
          </TextBlock>
        </Grid>

      </Grid>
    </Border>

    <!-- The buttons overlay the empty right-hand end of the tab strip. They stay outside
         the TabControl template on purpose: inside it they would land in the template's
         namescope and the code-behind could no longer reach them as fields. -->
    <Grid Grid.Row="1">
      <TabControl x:Name="SeqTabs">
      <TabItem Header="C1">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="C1Grid"
                        ItemsPanel="{StaticResource FieldItemsPanel}"
                        ItemTemplate="{StaticResource FieldItemTemplate}"/>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="C2">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="C2Grid"
                        ItemsPanel="{StaticResource FieldItemsPanel}"
                        ItemTemplate="{StaticResource FieldItemTemplate}"/>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="C3">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="C3Grid"
                        ItemsPanel="{StaticResource FieldItemsPanel}"
                        ItemTemplate="{StaticResource FieldItemTemplate}"/>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="V1">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="V1Grid"
                        ItemsPanel="{StaticResource FieldItemsPanel}"
                        ItemTemplate="{StaticResource FieldItemTemplate}"/>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="V2">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="V2Grid"
                        ItemsPanel="{StaticResource FieldItemsPanel}"
                        ItemTemplate="{StaticResource FieldItemTemplate}"/>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="V3">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="V3Grid"
                        ItemsPanel="{StaticResource FieldItemsPanel}"
                        ItemTemplate="{StaticResource FieldItemTemplate}"/>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Setpoints">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="SetpointGrid"
                        ItemsPanel="{StaticResource FieldItemsPanel}"
                        ItemTemplate="{StaticResource FieldItemTemplate}"/>
        </ScrollViewer>
      </TabItem>
      </TabControl>

      <!-- Height matches the TabItem height so these sit centred in the tab band. -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Height="38" Margin="0,0,8,0">
        <ToggleButton x:Name="EditToggle" Content="Edit Mode" VerticalAlignment="Center"
                      Checked="EditToggle_Checked" Unchecked="EditToggle_Unchecked"/>
        <Button x:Name="ExportBtn" Content="Save Changes" Margin="8,0,0,0" VerticalAlignment="Center"
                Click="ExportZip_Click"/>
        <Button x:Name="ExportPlcBtn" Content="Download to PLC" Margin="8,0,0,0" VerticalAlignment="Center"
                Click="ExportToPlc_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
