<Window x:Class="SequenceNavigator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:local="clr-namespace:SequenceNavigator"
        Title="Sequence Navigator" Height="820" Width="1180" Icon="CA.ico"
        MinWidth="1040" MinHeight="600"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <Style x:Key="DescTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#222"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding DataContext.ShowDescriptions, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
            <Condition Binding="{Binding HasDescription}" Value="True"/>
          </MultiDataTrigger.Conditions>
          <Setter Property="Visibility" Value="Visible"/>
        </MultiDataTrigger>
      </Style.Triggers>
    </Style>
    <!-- Card text uses exactly two sizes: 12 for the description and the value, 11 for
         the tag name. Every one is set explicitly, because anything left unset inherits
         13 from the Window style and produced a third size inside the same card. -->
    <Style x:Key="TagTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Foreground" Value="#666"/>
    </Style>

    <!-- Shared by every SEQ group tab. Declared after the styles above because
         StaticResource resolves in parse order. -->
    <ItemsPanelTemplate x:Key="FieldItemsPanel">
      <UniformGrid Columns="4"/>
    </ItemsPanelTemplate>

    <!-- The card. Its layout mirrors the plant HMI on purpose: four across, one step at a
         time, green fill on active values. Approved changes (2026-10-06): values read as
         dark text while viewing, tag names darken on green, and the outline is darker.
         Nothing else here should change without checking against the HMI. -->
    <DataTemplate x:Key="FieldItemTemplate">
      <Border Style="{StaticResource CardBorderStyle}">
        <Border.Background>
          <MultiBinding Converter="{StaticResource ValueHighlightConverter}">
            <Binding Path="Value"/>
            <Binding Path="DataContext.HighlightActive" RelativeSource="{RelativeSource AncestorType=Window}"/>
          </MultiBinding>
        </Border.Background>
        <StackPanel>
          <TextBlock Text="{Binding Description}" Style="{StaticResource DescTextStyle}"/>
          <TextBlock Text="{Binding Name}" Style="{StaticResource TagTextStyle}">
            <TextBlock.Foreground>
              <MultiBinding Converter="{StaticResource ValueHighlightConverter}" ConverterParameter="TagForeground">
                <Binding Path="Value"/>
                <Binding Path="DataContext.HighlightActive" RelativeSource="{RelativeSource AncestorType=Window}"/>
              </MultiBinding>
            </TextBlock.Foreground>
          </TextBlock>

          <!-- Viewing: the value as plain dark text, in a box the same size as the input
               it stands in for, so switching to Edit Mode moves nothing. -->
          <Border MinHeight="32" Padding="10,0" CornerRadius="4" Background="#B3FFFFFF"
                  BorderBrush="#33000000" BorderThickness="1">
            <TextBlock Text="{Binding Value}" FontSize="12" FontWeight="SemiBold" Foreground="#1F2430"
                       VerticalAlignment="Center"/>
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                      <Condition Binding="{Binding IsBoolean}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                  </MultiDataTrigger>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                      <Condition Binding="{Binding IsNumber}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
          </Border>

          <!-- Editing, boolean fields: dropdown. The array stays inline so each card gets
               its own instance rather than every ComboBox sharing one collection view. -->
          <ComboBox SelectedItem="{Binding Value, Mode=TwoWay}" FontSize="12">
            <ComboBox.Style>
              <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                      <Condition Binding="{Binding IsBoolean}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </ComboBox.Style>
            <ComboBox.ItemsSource>
              <x:Array Type="sys:String">
                <sys:String>true</sys:String>
                <sys:String>false</sys:String>
              </x:Array>
            </ComboBox.ItemsSource>
          </ComboBox>

          <!-- Editing, numeric fields: text box. -->
          <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" FontSize="12"
                   MinWidth="140" HorizontalAlignment="Stretch">
            <TextBox.Style>
              <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                      <Condition Binding="{Binding IsNumber}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </TextBox.Style>
          </TextBox>

          <!-- Anything else: read-only. -->
          <TextBlock Text="{Binding Value}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding IsBoolean}" Value="False"/>
                      <Condition Binding="{Binding IsNumber}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Margin="16,16,16,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Header: file actions and the open backup on top; sequence and step navigation
           below a thin divider. -->
      <Border Grid.Row="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" Padding="12" CornerRadius="6" Margin="0,0,0,10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="OpenZipBtn" Grid.Column="0" Click="OpenZip_Click" ToolTip="Open a backup ZIP (Ctrl+O)">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;"/>
                <TextBlock Style="{StaticResource ButtonLabel}" Text="Open backup"/>
              </StackPanel>
            </Button>
            <Button x:Name="ImportBtn" Grid.Column="1" Margin="8,0,0,0" Click="ImportFromPlc_Click"
                    ToolTip="Read every sequence from a PLC into a new backup (Ctrl+U)">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE898;"/>
                <TextBlock Style="{StaticResource ButtonLabel}" Text="Upload from PLC"/>
              </StackPanel>
            </Button>
            <!-- The open backup: its name, and where and when it came from. -->
            <StackPanel Grid.Column="2" Margin="16,0" VerticalAlignment="Center">
              <TextBlock x:Name="PathBox" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="FileDetailText" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button x:Name="FindBtn" Grid.Column="3" Click="Find_Click"
                    ToolTip="Find where a field is on, across every sequence (Ctrl+F)">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE721;"/>
                <TextBlock Style="{StaticResource ButtonLabel}" Text="Find"/>
              </StackPanel>
            </Button>
            <Button x:Name="CompareBtn" Grid.Column="4" Margin="8,0,0,0" Click="CompareSequences_Click"
                    ToolTip="Compare two backups, or a backup with the PLC (Ctrl+Shift+C)">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE8AB;"/>
                <TextBlock Style="{StaticResource ButtonLabel}" Text="Compare"/>
              </StackPanel>
            </Button>
            <Button x:Name="AdvancedBtn" Grid.Column="5" Margin="8,0,0,0" Click="AdvancedSettings_Click" ToolTip="Settings">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE713;"/>
                <TextBlock Style="{StaticResource ButtonLabel}" Text="Settings"/>
              </StackPanel>
            </Button>
          </Grid>

          <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,12"/>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="JsonPicker" Grid.Column="0" Width="260" MinHeight="40"
                      SelectionChanged="JsonPicker_SelectionChanged" AutomationProperties.Name="Sequence"
                      ToolTip="Sequence. Type the first letters to jump to one."/>
            <!-- The step readout leads the navigation group. MinWidth keeps "Step 9" and
                 "Step 99" the same width so the buttons beside it never shift. -->
            <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" MinWidth="70">
              <TextBlock x:Name="IndexLabel" FontWeight="Bold" FontSize="15" TextAlignment="Center"/>
            </StackPanel>
            <Button x:Name="PrevBtn" Grid.Column="2" Style="{StaticResource NavButton}" Margin="12,0,0,0"
                    Click="Prev_Click" ToolTip="Previous step (Page Up)">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE76B;" FontSize="12"/>
                <TextBlock Style="{StaticResource ButtonLabel}" Text="Prev"/>
              </StackPanel>
            </Button>
            <!-- Type a step and press Enter. Locked to a 40x40 square, the same height as the
                 buttons beside it; digits only and two characters at most. Padding is zeroed
                 so two digits fit, centred both ways. -->
            <TextBox x:Name="IndexBox" Grid.Column="3" VerticalAlignment="Center" Margin="8,0,0,0"
                     Width="40" Height="40" MinWidth="40" MinHeight="40" MaxWidth="40" MaxHeight="40"
                     Padding="0" TextAlignment="Center" VerticalContentAlignment="Center"
                     MaxLength="2" ToolTip="Type a step number and press Enter (Ctrl+G)"
                     AutomationProperties.Name="Step number"
                     KeyDown="IndexBox_KeyDown" PreviewTextInput="IndexBox_PreviewTextInput"
                     TextChanged="IndexBox_TextChanged"/>
            <Button x:Name="NextBtn" Grid.Column="4" Style="{StaticResource NavButton}" Margin="8,0,0,0"
                    Click="Next_Click" ToolTip="Next step (Page Down)">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource ButtonLabel}" Text="Next"/>
                <TextBlock Style="{StaticResource IconText}" Text="&#xE76C;" FontSize="12" Margin="8,0,0,0"/>
              </StackPanel>
            </Button>
            <!-- Sequences fill their steps in order from step 1, so the useful jumps are to
                 either end: step 1, and the last step in use. -->
            <Button x:Name="FirstStepBtn" Grid.Column="5" Style="{StaticResource NavButton}" Margin="16,0,0,0"
                    Click="FirstStep_Click" ToolTip="Go to step 1 (Ctrl+Page Up)">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE892;" FontSize="12"/>
                <TextBlock Style="{StaticResource ButtonLabel}" Text="First"/>
              </StackPanel>
            </Button>
            <Button x:Name="LastStepBtn" Grid.Column="6" Style="{StaticResource NavButton}" Margin="8,0,0,0"
                    Click="LastStep_Click" ToolTip="Go to the last step in use (Ctrl+Page Down)">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource ButtonLabel}" Text="Last"/>
                <TextBlock Style="{StaticResource IconText}" Text="&#xE893;" FontSize="12" Margin="8,0,0,0"/>
              </StackPanel>
            </Button>
            <TextBlock x:Name="StepUsageText" Grid.Column="7" Margin="16,0,8,0" VerticalAlignment="Center"
                       FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis"/>

            <!-- Steady, not blinking: high-performance HMI practice keeps blinking for alarms.
                 Amber means "editing" everywhere in the app. -->
            <Border x:Name="EditBanner" Grid.Column="8" Background="{StaticResource EditingBg}"
                    BorderBrush="{StaticResource EditingBorder}" BorderThickness="1" CornerRadius="6"
                    Padding="12,6" Visibility="Collapsed" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="13"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="EditBannerText" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Border>

      <local:InfoBar x:Name="Info" Grid.Row="1"/>

      <!-- The buttons overlay the empty right-hand end of the tab strip. They stay outside
           the TabControl template on purpose: inside it they would land in the template's
           namescope and the code-behind could no longer reach them as fields. -->
      <Grid Grid.Row="2">
        <TabControl x:Name="SeqTabs" SelectionChanged="SeqTabs_SelectionChanged">
          <TabItem Header="C1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="C1Grid"
                            ItemsPanel="{StaticResource FieldItemsPanel}"
                            ItemTemplate="{StaticResource FieldItemTemplate}"/>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="C2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="C2Grid"
                            ItemsPanel="{StaticResource FieldItemsPanel}"
                            ItemTemplate="{StaticResource FieldItemTemplate}"/>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="C3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="C3Grid"
                            ItemsPanel="{StaticResource FieldItemsPanel}"
                            ItemTemplate="{StaticResource FieldItemTemplate}"/>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="V1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="V1Grid"
                            ItemsPanel="{StaticResource FieldItemsPanel}"
                            ItemTemplate="{StaticResource FieldItemTemplate}"/>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="V2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="V2Grid"
                            ItemsPanel="{StaticResource FieldItemsPanel}"
                            ItemTemplate="{StaticResource FieldItemTemplate}"/>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="V3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="V3Grid"
                            ItemsPanel="{StaticResource FieldItemsPanel}"
                            ItemTemplate="{StaticResource FieldItemTemplate}"/>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Setpoints">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="SetpointGrid"
                            ItemsPanel="{StaticResource FieldItemsPanel}"
                            ItemTemplate="{StaticResource FieldItemTemplate}"/>
            </ScrollViewer>
          </TabItem>
        </TabControl>

        <!-- Shown while a PLC transfer runs, and until an upload has been saved. A solid
             panel over the card area: during a download or comparison the cards are still
             loaded, and must neither show through the spinner nor be clickable mid-transfer.
             The top margin keeps it clear of the 40-high tab strip. -->
        <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Margin="1,40,1,1" Background="{StaticResource PanelBg}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Canvas x:Name="Spinner" Width="72" Height="72" RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
              <RotateTransform/>
            </Canvas.RenderTransform>
            <Canvas.Style>
              <Style TargetType="Canvas">
                <Style.Triggers>
                  <!-- Spins only while visible, so a hidden spinner costs nothing. -->
                  <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                      <BeginStoryboard x:Name="SpinnerSpin">
                        <Storyboard RepeatBehavior="Forever">
                          <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                           From="0" To="360" Duration="0:0:1"/>
                        </Storyboard>
                      </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                      <StopStoryboard BeginStoryboardName="SpinnerSpin"/>
                    </Trigger.ExitActions>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </Canvas.Style>
            <!-- Eight dots on a 26-radius ring. Brightest at the head, fading along the
                 tail, so the clockwise spin reads as one moving comet. -->
            <Ellipse Canvas.Left="31"    Canvas.Top="5"     Width="10" Height="10" Fill="#8C96AA" Opacity="1"/>
            <Ellipse Canvas.Left="49.38" Canvas.Top="12.62" Width="10" Height="10" Fill="#8C96AA" Opacity="0.15"/>
            <Ellipse Canvas.Left="57"    Canvas.Top="31"    Width="10" Height="10" Fill="#8C96AA" Opacity="0.25"/>
            <Ellipse Canvas.Left="49.38" Canvas.Top="49.38" Width="10" Height="10" Fill="#8C96AA" Opacity="0.35"/>
            <Ellipse Canvas.Left="31"    Canvas.Top="57"    Width="10" Height="10" Fill="#8C96AA" Opacity="0.46"/>
            <Ellipse Canvas.Left="12.62" Canvas.Top="49.38" Width="10" Height="10" Fill="#8C96AA" Opacity="0.58"/>
            <Ellipse Canvas.Left="5"     Canvas.Top="31"    Width="10" Height="10" Fill="#8C96AA" Opacity="0.7"/>
            <Ellipse Canvas.Left="12.62" Canvas.Top="12.62" Width="10" Height="10" Fill="#8C96AA" Opacity="0.85"/>
          </Canvas>
          <TextBlock x:Name="LoadingCaption" Text="Uploading from PLC" Margin="0,16,0,0" HorizontalAlignment="Center"
                     FontSize="14" Foreground="{StaticResource SubtleTextBrush}"/>
          </StackPanel>
        </Grid>

        <!-- Start screen: what to do when nothing is open, instead of an empty grid. -->
        <Border x:Name="StartScreen" Background="{StaticResource AppBg}" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" Margin="24,32">
              <TextBlock Text="Open a sequence backup" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock Style="{StaticResource HintText}" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,24"
                         Text="View paint-system sequences step by step, compare backups, or read a fresh copy from a PLC."/>

              <UniformGrid Columns="3">
                <Button Margin="0,0,8,0" Padding="16,14" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Click="OpenZip_Click">
                  <StackPanel>
                    <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Open backup" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,2"/>
                    <TextBlock Text="A ZIP saved earlier · Ctrl&#x2060;+&#x2060;O" Style="{StaticResource HintText}"/>
                  </StackPanel>
                </Button>
                <Button Margin="4,0" Padding="16,14" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Click="ImportFromPlc_Click">
                  <StackPanel>
                    <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Upload from PLC" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,2"/>
                    <TextBlock Text="Read every sequence from a PLC · Ctrl&#x2060;+&#x2060;U" Style="{StaticResource HintText}"/>
                  </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" Padding="16,14" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Click="CompareSequences_Click">
                  <StackPanel>
                    <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Compare backups" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,2"/>
                    <TextBlock Text="See what changed between two" Style="{StaticResource HintText}"/>
                  </StackPanel>
                </Button>
              </UniformGrid>

              <TextBlock Text="RECENT BACKUPS" Style="{StaticResource SectionHeader}" Margin="0,28,0,8"/>
              <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                  <ItemsControl x:Name="RecentList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource QuietButton}" HorizontalContentAlignment="Stretch"
                                Padding="14,8" Tag="{Binding Path}" Click="RecentItem_Click" ToolTip="{Binding Path}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"
                                         TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock x:Name="NoRecentText" Text="No recent backups yet." Style="{StaticResource HintText}"
                             Margin="14,12" Visibility="Collapsed"/>
                </StackPanel>
              </Border>
              <TextBlock Style="{StaticResource HintText}" HorizontalAlignment="Center" Margin="0,16,0,0"
                         Text="Or drop a backup ZIP anywhere in this window."/>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- Height matches the TabItem height so these sit centred in the tab band. -->
        <StackPanel x:Name="TabBandButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Height="40" Margin="0,0,8,0">
          <ToggleButton x:Name="EditToggle" VerticalAlignment="Center" ToolTip="Edit values in this backup (Ctrl+E)"
                        Checked="EditToggle_Checked" Unchecked="EditToggle_Unchecked">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource IconText}" Text="&#xE70F;"/>
              <TextBlock Style="{StaticResource ButtonLabel}" Text="Edit Mode"/>
            </StackPanel>
          </ToggleButton>
          <Button x:Name="ExportBtn" Margin="8,0,0,0" VerticalAlignment="Center" Click="ExportZip_Click"
                  ToolTip="Save your changes to this backup (Ctrl+S)">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;"/>
              <TextBlock Style="{StaticResource ButtonLabel}" Text="Save changes"/>
            </StackPanel>
          </Button>
          <!-- Set apart from Edit and Save: the one action that changes a controller. -->
          <Border Width="1" Height="24" Background="{StaticResource BorderBrush}" Margin="12,0"/>
          <Button x:Name="ExportPlcBtn" Style="{StaticResource DangerButton}" VerticalAlignment="Center"
                  Click="ExportToPlc_Click" ToolTip="Write this backup's sequences to a PLC">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource IconText}" Text="&#xE896;"/>
              <TextBlock Style="{StaticResource ButtonLabel}" Text="Download to PLC"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Status bar: routine confirmations land here instead of in pop-ups. -->
    <Border Grid.Row="1" Background="{StaticResource StatusBarBg}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="16,5">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <TextBlock x:Name="EditStateText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#8A6100"
                   Margin="16,0,0,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="VersionText" Grid.Column="2" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"
                   Margin="16,0,0,0" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
